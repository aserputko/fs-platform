# --- Runtime ---
NODE_ENV=development
PORT=3002
SWAGGER_ENABLED=true

# --- Logging ---
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable output for local development; leave unset in every deployed environment.
LOG_PRETTY=true

# --- Database ---
DATABASE_URL="postgresql://project:project@localhost:5433/project_db?schema=public"

# --- JWT (RS256, verify only) ---
# These must match be-identity-service exactly: they are the `iss` and `aud` claims
# it stamps on the tokens this service verifies, NOT this service's own address.
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=fs-platform

# Base64-encoded PEM. Copy be-identity-service's JWT_PUBLIC_KEY_B64 verbatim.
# This service never signs, so it must never be given the private key.
JWT_PUBLIC_KEY_B64=

# Optional: keep the retired public key here during a rotation so access tokens
# signed with the previous key still verify.
JWT_PREVIOUS_PUBLIC_KEY_B64=

# Optional: overrides the RFC 7638 thumbprint that is otherwise used as `kid`.
JWT_KEY_ID=
