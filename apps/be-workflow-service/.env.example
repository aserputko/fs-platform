# --- Runtime ---
NODE_ENV=development
PORT=3003
SWAGGER_ENABLED=true

# --- Logging ---
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable output for local development; leave unset in every deployed environment.
LOG_PRETTY=true

# --- Database ---
DATABASE_URL="postgresql://workflow:workflow@localhost:5434/workflow_db?schema=public"

# --- User JWT (RS256, verify only) ---
# These must match be-identity-service exactly: they are the `iss` and `aud` claims
# it stamps on the tokens this service verifies, NOT this service's own address.
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=fs-platform

# Base64-encoded PEM. Copy be-identity-service's JWT_PUBLIC_KEY_B64 verbatim.
# This service never signs, so it must never be given the private key.
JWT_PUBLIC_KEY_B64=

# Optional: keep the retired public key here during a rotation so access tokens
# signed with the previous key still verify.
JWT_PREVIOUS_PUBLIC_KEY_B64=

# Optional: overrides the RFC 7638 thumbprint that is otherwise used as `kid`.
JWT_KEY_ID=

# --- Service JWT (RS256, verify only) ---
# A SEPARATE key pair from the user one above, produced by:
#   npm run keys:generate --workspace @fs-platform/be-identity-service -- --service
# Executor services hold its private key; a leak lets a caller reach /internal/* but can
# never forge a user login, because user tokens use a different key and a different audience.
SERVICE_JWT_PUBLIC_KEY_B64=
SERVICE_JWT_AUDIENCE=fs-platform-internal
# Comma-separated allow-list of `iss` claims permitted on service tokens.
SERVICE_JWT_ISSUERS=svc:be-project-service

# --- Identity lookup (display names only) ---
# Resolves userIds to display names. Failures degrade to null names, never a 5xx.
IDENTITY_BASE_URL=http://localhost:3001
IDENTITY_TIMEOUT_MS=2000
USER_CACHE_TTL_SECONDS=60
