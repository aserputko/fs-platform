# --- Runtime ---
NODE_ENV=development
PORT=3001
SWAGGER_ENABLED=true

# --- Database ---
DATABASE_URL="postgresql://identity:identity@localhost:5432/identity_db?schema=public"

# --- JWT (RS256) ---
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=fs-platform
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Base64-encoded PEM key pair. Generate with: npm run keys:generate
# Base64 avoids newline-escaping problems in .env files and container env vars.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=

# Optional: keep the retired public key here during a rotation so old access
# tokens still verify and the JWKS endpoint advertises both keys.
JWT_PREVIOUS_PUBLIC_KEY_B64=

# Optional: overrides the RFC 7638 thumbprint that is otherwise used as `kid`.
JWT_KEY_ID=
